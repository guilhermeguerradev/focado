# Modelo do .env (sem valores reais). Copie para .env e preencha.
# Os valores do Supabase local aparecem ao rodar: npx supabase status

# Crie também um arquivo .env.local (só seu, não vai para o Git) com:
#   REACT_NATIVE_PACKAGER_HOSTNAME=<IP do seu PC no Wi-Fi>
# Isso força o Expo a usar o IP do Wi-Fi no QR Code (e não um IP virtual do Docker/WSL).
# Descubra o IP com: ipconfig (Adaptador de Rede sem Fio Wi-Fi > Endereço IPv4)

# Mesmo IP, com a porta do Supabase, ex.: http://192.168.0.10:54321
EXPO_PUBLIC_SUPABASE_URL=
# "Publishable key" mostrada pelo supabase status
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NUNCA coloque aqui a SECRET_KEY / service_role: ela não pode ir para o app.
