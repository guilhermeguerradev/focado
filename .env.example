# Modelo do .env (sem valores reais). Copie para .env e preencha.
# Os valores do Supabase local aparecem ao rodar: npx supabase status

# IP do seu PC no Wi-Fi, ex.: http://192.168.0.10:54321
EXPO_PUBLIC_SUPABASE_URL=
# "Publishable key" mostrada pelo supabase status
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NUNCA coloque aqui a SECRET_KEY / service_role: ela não pode ir para o app.
